# ─── Configuration Frontend CleanPro Vitrine & Dashboard ─────────────────────
# URL de base de l'API Backend CleanPro
#
# Option A (Reverse proxy Nginx ou même domaine) :
# VITE_API_URL=/api
#
# Option B (Développement local direct sans proxy) :
# VITE_API_URL=http://localhost:5000/api
#
# Option C (Domaine ou hébergement Cloud distinct) :
# VITE_API_URL=https://api.cleanpro.cm/api
VITE_API_URL=/api

